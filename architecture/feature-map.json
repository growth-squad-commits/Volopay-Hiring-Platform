{
  "version": 1,
  "features": {
    "design-system": {
      "entry": "src/app/globals.css",
      "owners": [
        "src/styles/tokens.css",
        "src/styles/base.css",
        "src/components/brand.tsx",
        "architecture/editorial-utility.md"
      ],
      "sharedDependencies": [],
      "dataOwnership": [],
