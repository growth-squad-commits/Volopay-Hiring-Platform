      ],
      "dataOwnership": [
        "candidates",
        "candidate_responses",
        "candidate-submissions"
      ],
      "validation": "npm run build"
    },
    "exam-attempt-processing": {
      "entry": "src/app/api/candidate/attempts/start/route.ts",
      "owners": [
        "src/app/api/candidate/attempts/[attemptId]/route.ts",
        "src/app/api/candidate/attempts/[attemptId]/answers/route.ts",
        "src/app/api/candidate/attempts/[attemptId]/submit/route.ts",
        "src/lib/server/candidate-attempts.ts",
