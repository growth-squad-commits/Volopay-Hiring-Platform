        "src/app/candidate/submission/[candidateId]/page.tsx",
        "src/app/candidate/thank-you/page.tsx",
        "src/components/candidate-workspace.tsx",
        "src/components/assessment-runner.tsx",
        "src/components/submission-confirmation.tsx",
