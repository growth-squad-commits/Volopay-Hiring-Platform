      "sharedDependencies": [
        "src/lib/server/auth.ts",
        "src/lib/server/rate-limit.ts",
        "src/lib/supabase"
      ],
      "dataOwnership": [
        "exam_attempts",
        "candidate_responses",
        "grading_queue"
      ],
      "validation": "npm run test:phase4"
    }
